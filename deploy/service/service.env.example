# Bind the published host port to loopback unless an authenticated private ingress is configured.
XAPIS_HOST_BIND=127.0.0.1
XAPIS_PORT=4140
XAPIS_BIND=0.0.0.0:4140
XAPIS_WORKERS=2
XAPIS_REQUEST_TIMEOUT=25
# Supply a private random key using your secret manager; never commit the real value.
XAPIS_API_KEY=
# For non-Compose execution, alternatively set a private 0600 key file path.
# XAPIS_API_KEY_FILE=
