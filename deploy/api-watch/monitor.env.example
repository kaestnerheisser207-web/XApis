# Private account.json created by `python -m api_watch init --directory watch-project`.
API_WATCH_SECRETS_FILE=secrets/account.json
# Optional legacy Cookie file override; paths resolve against this env file.
API_WATCH_COOKIES_FILE=
API_WATCH_PROXY=
# Generic JSON webhook. Leave empty to emit alerts to stdout only.
API_WATCH_WEBHOOK_URL=
