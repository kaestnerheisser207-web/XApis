FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 API_WATCH_STATE_DIR=/state
WORKDIR /app
COPY requirements-watch.txt ./
COPY pyproject.toml ./
RUN apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements-watch.txt \
    && groupadd --gid 10001 monitor \
    && useradd --uid 10001 --gid monitor --no-create-home monitor \
    && mkdir /state && chown monitor:monitor /state && chmod 700 /state
COPY api_watch/ api_watch/
COPY api_watch/fixtures/ fixtures/
COPY builder/ builder/
COPY utils/ utils/
COPY x_apis/ x_apis/
COPY static/graphql.json static/transaction_l1.json static/
COPY static/ui_metrics.js static/
COPY static/castle/ static/castle/
COPY deploy/api-watch/config.example.json /app/watch.json
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -m api_watch health
ENTRYPOINT ["python", "-m", "api_watch"]
CMD ["--config", "/app/watch.json", "run"]
